# Day12 Production Agent — environment template
# Copy to .env and fill in real values. NEVER commit .env.

# deployment environment: development | staging | production
ENVIRONMENT=production

# port the server listens on (Render/Railway inject PORT automatically)
PORT=8000

# Redis connection string (docker compose: redis service hostname)
REDIS_URL=redis://redis:6379/0

# secret API key clients must send in the X-API-Key header
AGENT_API_KEY=replace-with-a-long-random-secret

# logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# per-user request limit per minute (HTTP 429 beyond this)
RATE_LIMIT_PER_MINUTE=10

# per-user monthly LLM budget in USD (HTTP 402 beyond this)
MONTHLY_BUDGET_USD=10
